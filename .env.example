# Copy this file to ".env" and replace YOUR_PASSWORD with your local
# PostgreSQL password. Never commit the real .env file.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/url_shortener

# Public base URL used when building short URLs (default: http://localhost:8000).
# Change this only if the API is reachable at a different address.
BASE_URL=http://localhost:8000